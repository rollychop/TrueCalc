[
  {
    "name": "calculate_emi",
    "description": "Monthly EMI for a loan (home, car, personal loan). Amount in rupees, rate is annual percent.",
    "parameters": {
      "type": "object",
      "properties": {
        "principal": {"type": "number", "description": "Loan amount in rupees", "exclusiveMinimum": 0},
        "annual_rate": {"type": "number", "description": "Annual interest rate in percent", "minimum": 0, "maximum": 100},
        "tenure": {"type": "number", "description": "Loan duration", "exclusiveMinimum": 0},
        "tenure_unit": {"type": "string", "enum": ["years", "months"], "default": "years"}
      },
      "required": ["principal", "annual_rate", "tenure"]
    }
  },
