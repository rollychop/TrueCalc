      },
      "required": ["weight_kg", "height_cm"]
    }
  },
  {
    "name": "calculate_daily_calories",
    "description": "Daily calorie needs (BMR and maintenance calories).",
    "parameters": {
      "type": "object",
      "properties": {
        "age": {"type": "integer", "minimum": 1, "maximum": 120},
        "weight_kg": {"type": "number", "exclusiveMinimum": 0, "maximum": 500},
        "height_cm": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
        "gender": {"type": "string", "enum": ["Male", "Female"], "default": "Male"},
        "activity": {"type": "string", "enum": ["Sedentary", "Lightly active", "Moderately active", "Very active", "Extra active"], "default": "Sedentary"}
